(version 1)

(deny default)

; Every descendant inherits the same profile.
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))

; Codex workspace-write reads the host filesystem by default. Confidential Eidos
; state is denied by the dynamic policy appended after this base policy.
(allow file-read*)
(allow file-map-executable)

; Minimal platform runtime required by system command-line tools.
(allow file-read* file-test-existence
  (literal "/")
  (subpath "/System")
  (subpath "/Library/Apple")
  (subpath "/Library/Developer")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/libexec")
  (subpath "/opt/homebrew")
  (subpath "/usr/local")
  (subpath "/private/etc")
  (literal "/var/select/developer_dir")
  (literal "/private/var/select/sh")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (subpath "/dev/fd"))

(allow file-read* file-test-existence
  (literal (param "FILE_COMMIT_HELPER")))

(allow file-read-metadata file-test-existence
  (path-ancestors "/opt/homebrew")
  (path-ancestors "/usr/local")
  (path-ancestors "/var/select")
  (path-ancestors (param "PYTHON_RUNTIME_ROOT"))
  (path-ancestors (param "PYTHON_BASE_RUNTIME_ROOT")))

; The active Eidos interpreter and its stdlib/dynamic libraries are bundled or
; uv-managed. They are read-only and may be mapped for Python execution.
(allow file-read* file-test-existence
  (subpath (param "PYTHON_RUNTIME_ROOT"))
  (subpath (param "PYTHON_BASE_RUNTIME_ROOT")))
(allow file-map-executable
  (subpath (param "PYTHON_RUNTIME_ROOT"))
  (subpath (param "PYTHON_BASE_RUNTIME_ROOT")))
(deny file-write*
  (subpath (param "PYTHON_RUNTIME_ROOT"))
  (subpath (param "PYTHON_BASE_RUNTIME_ROOT")))

(allow file-map-executable
  (subpath "/System")
  (subpath "/Library/Apple")
  (subpath "/Library/Developer")
  (subpath "/opt/homebrew")
  (subpath "/usr/local")
  (subpath "/usr/lib"))

(allow file-write-data
  (literal "/dev/null")
  (literal "/dev/zero")
  (subpath "/dev/fd"))

(allow sysctl-read)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership"))

; Permit traversal to parameterized roots without granting their parents.
(allow file-read-metadata file-test-existence
  (path-ancestors (param "WORKSPACE_ROOT"))
  (path-ancestors (param "GIT_WORKTREE_DIR"))
  (path-ancestors (param "GIT_COMMON_DIR"))
  (path-ancestors (param "SANDBOX_HOME"))
  (path-ancestors (param "SANDBOX_TMP"))
  (path-ancestors (param "SYSTEM_TMP_ROOT")))

; Workspace is readable by the default file-read rule.
(allow file-read* file-test-existence
  (subpath (param "WORKSPACE_ROOT")))

; Linked Worktrees keep their Git metadata in the verified common directory.
; The original repository working tree is not granted by this rule.
(allow file-read* file-read-metadata file-test-existence
  (subpath (param "GIT_WORKTREE_DIR")))
(deny file-write*
  (literal (param "GIT_WORKTREE_DIR"))
  (subpath (param "GIT_WORKTREE_DIR")))
(allow file-read* file-read-metadata file-test-existence
  (subpath (param "GIT_COMMON_DIR")))
(deny file-write*
  (literal (param "GIT_COMMON_DIR"))
  (subpath (param "GIT_COMMON_DIR")))

; Workspace is writable except for Git metadata.
(allow file-write*
  (require-all
    (subpath (param "WORKSPACE_ROOT"))
    (require-not (literal (param "GIT_DIR")))
    (require-not (subpath (param "GIT_DIR")))
    (require-not (literal (param "GIT_WORKTREE_DIR")))
    (require-not (subpath (param "GIT_WORKTREE_DIR")))
    (require-not (literal (param "GIT_COMMON_DIR")))
    (require-not (subpath (param "GIT_COMMON_DIR")))))

; HOME remains read-only. TMPDIR and the canonical system temp root are
; writable for normal command scratch files.
(allow file-write*
  (subpath (param "SANDBOX_TMP"))
  (subpath (param "SYSTEM_TMP_ROOT")))

; Network, loopback, bind, and Unix sockets remain denied by default.
