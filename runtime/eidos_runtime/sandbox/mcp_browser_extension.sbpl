(version 1)
(deny default)

; Playwright MCP for the bundled Eidos browser plugin in Playwright Extension
; mode: the same rules as mcp_browser.sbpl, plus listening for the extension.
; Playwright's relay listens on 127.0.0.1 for the user's Chrome extension to
; connect. It never launches Chrome; a helper hands the connect page URL to
; the Runtime broker through a Unix socket in SANDBOX_TMP.
;
; Seatbelt's "localhost" filter matches every address of this Mac, so a
; process here could also accept connections that arrive on the Mac's LAN
; address. Only the bundled, hash-checked Playwright MCP runs with this
; profile and the relay binds 127.0.0.1; outbound traffic is still limited
; to this Mac. See docs/design/shared-chrome-tab-group-design.md section 7.
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership"))

(allow file-read* file-test-existence
  (literal "/")
  (subpath "/System")
  (subpath "/Library/Apple")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/private/etc")
  (subpath "/dev/fd")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom"))

(allow file-read-metadata file-test-existence
  (path-ancestors (param "PLUGIN_ROOT"))
  (path-ancestors (param "WORKSPACE_ROOT"))
  (path-ancestors (param "SANDBOX_HOME"))
  (path-ancestors (param "SANDBOX_TMP"))
  (path-ancestors (param "NODE_RUNTIME_ROOT"))
  (path-ancestors (param "BROWSER_RUNTIME_ROOT")))
(allow file-read* file-test-existence
  (subpath (param "PLUGIN_ROOT"))
  (subpath (param "WORKSPACE_ROOT"))
  (subpath (param "NODE_RUNTIME_ROOT"))
  (subpath (param "BROWSER_RUNTIME_ROOT")))
(allow file-map-executable
  (subpath (param "NODE_RUNTIME_ROOT")))
(deny file-write*
  (subpath (param "WORKSPACE_ROOT"))
  (subpath (param "NODE_RUNTIME_ROOT"))
  (subpath (param "BROWSER_RUNTIME_ROOT")))
(allow file-read* file-test-existence file-write*
  (subpath (param "SANDBOX_HOME"))
  (subpath (param "SANDBOX_TMP")))
(allow file-write-data
  (literal "/dev/null")
  (literal "/dev/zero")
  (subpath "/dev/fd"))

(allow network-outbound (remote ip "localhost:*"))
(allow network* (local unix-socket (subpath (param "SANDBOX_TMP"))))
(allow network-outbound (remote unix-socket (subpath (param "SANDBOX_TMP"))))

(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
