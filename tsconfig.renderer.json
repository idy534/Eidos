{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["vite/client"]
  },
  "include": ["desktop/renderer/src", "desktop/shared/**/*.ts", "desktop/shared/**/*.cts"],
  "exclude": [
    "desktop/renderer/src/**/*.test.ts",
    "desktop/renderer/src/**/*.test.tsx",
    "desktop/shared/**/*.test.ts"
  ]
}
