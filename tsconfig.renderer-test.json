{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "desktop",
    "outDir": "dist/renderer-test",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "desktop/shared/**/*.ts",
    "desktop/shared/**/*.cts",
    "desktop/renderer/src/**/*.d.ts",
    "desktop/renderer/src/contracts.ts",
    "desktop/renderer/src/session-state.ts",
    "desktop/renderer/src/app/useApprovalController.ts",
    "desktop/renderer/src/app/useModelController.ts",
    "desktop/renderer/src/app/useRunController.ts",
    "desktop/renderer/src/components/MarkdownContent.tsx",
    "desktop/renderer/src/components/ExecutionFeed.tsx",
    "desktop/renderer/src/components/PrimaryActionButton.tsx",
    "desktop/renderer/src/components/Button.tsx",
    "desktop/renderer/src/components/Composer.tsx",
    "desktop/renderer/src/components/DropdownMenu.tsx",
    "desktop/renderer/src/**/*.test.ts",
    "desktop/renderer/src/**/*.test.tsx"
  ],
  "exclude": [
    "desktop/renderer/src/**/*.behavior.test.ts",
    "desktop/renderer/src/**/*.behavior.test.tsx"
  ]
}
