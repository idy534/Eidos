{
  "name": "eidos",
  "productName": "Eidos",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm build:preload && pnpm build:main && pnpm build:renderer",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && vite build",
    "start": "pnpm build && electron .",
    "test": "pnpm test:runtime && pnpm test:desktop",
    "test:runtime": ".venv/bin/python -m unittest discover -s runtime/tests -v",
    "test:contracts": "node scripts/check-desktop-contracts.mjs",
    "test:renderer-state": "tsc -p tsconfig.renderer-test.json && node --test dist/renderer-test/shared/ipc-contracts.test.js dist/renderer-test/renderer/src/session-state.test.js dist/renderer-test/renderer/src/composer-mode.test.js dist/renderer-test/renderer/src/runtime-presentation.test.js dist/renderer-test/renderer/src/app/model-controller.test.js dist/renderer-test/renderer/src/app/approval-controller.test.js dist/renderer-test/renderer/src/app/run-controller.test.js dist/renderer-test/renderer/src/components/MarkdownContent.test.js dist/renderer-test/renderer/src/components/ExecutionFeed.test.js dist/renderer-test/renderer/src/components/PrimaryActionButton.test.js dist/renderer-test/renderer/src/components/Button.test.js dist/renderer-test/renderer/src/components/DropdownMenu.test.js",
    "test:renderer-behavior": "vitest run --config vitest.renderer.config.ts",
    "test:main": "node --test dist/main/log-redaction.test.js dist/main/runtime-shutdown.test.js dist/main/shortcut-dispatch.test.js dist/main/quit-flow.test.js dist/main/runtime-client.test.js",
    "test:desktop": "pnpm test:contracts && pnpm build && pnpm test:renderer-state && pnpm test:renderer-behavior && pnpm test:main"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^42.4.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
