{
  "name": "eidos",
  "productName": "Eidos",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm build:preload && pnpm build:main && pnpm build:renderer",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && vite build",
    "postinstall": "node scripts/prepare-node-pty.mjs",
    "start": "pnpm build && electron .",
    "python:sync": "uv sync --locked",
    "test": "pnpm test:full",
    "test:affected": "node scripts/test-affected.mjs",
    "test:fast": "pnpm test:runtime:fast && pnpm test:contracts && pnpm test:renderer-state && pnpm test:main:fast && pnpm test:renderer-behavior",
    "test:runtime:fast": "uv run --locked pytest -m \"not integration and not slow and not platform and not large_repository\"",
    "test:runtime:full": "uv run --locked pytest -m \"not large_repository\"",
    "test:runtime:scale": "uv run --locked pytest -m \"large_repository\"",
    "test:runtime": "pnpm test:runtime:full",
    "test:integration": "uv run --locked pytest -m \"(integration or slow or platform) and not large_repository\"",
    "test:full": "pnpm test:runtime:full && pnpm test:contracts && pnpm test:renderer-state && pnpm test:main && pnpm test:renderer-behavior",
    "test:release": "pnpm package:mac:release",
    "lint:python": "uv run --locked ruff check runtime/eidos_runtime runtime/tests scripts/test-seatbelt-native.py",
    "deps:python": "uv run --locked deptry runtime/eidos_runtime",
    "audit:python": "scripts/audit-python.sh",
    "check:python:static": "pnpm lint:python && pnpm deps:python && pnpm audit:python",
    "check:python": "pnpm check:python:static",
    "check:python:full": "pnpm check:python:static && pnpm test:runtime:full",
    "test:contracts": "node --test scripts/check-desktop-contracts.test.mjs && node scripts/check-desktop-contracts.mjs",
    "test:renderer-state": "node scripts/check-renderer-test-discovery.mjs && node --test \"dist/renderer-test/**/*.test.js\"",
    "test:renderer-behavior": "vitest run --config vitest.renderer.config.ts",
    "test:main:fast": "pnpm build:main && node --test dist/main/app-command-dispatch.test.js dist/main/log-redaction.test.js dist/main/quit-flow.test.js dist/main/runtime-paths.test.js dist/main/runtime-shutdown.test.js dist/main/terminal-manager.test.js",
    "test:main": "pnpm build:main && node --test \"dist/main/*.test.js\"",
    "test:desktop": "pnpm build && pnpm test:contracts && pnpm test:renderer-state && pnpm test:renderer-behavior && pnpm test:main",
    "test:seatbelt-native": ".venv/bin/python scripts/test-seatbelt-native.py",
    "test:electron-smoke": "node scripts/electron-smoke.mjs",
    "build:runtime:mac": "bash scripts/build-macos-runtime.sh",
    "test:runtime:bundled": "node scripts/bundled-runtime-smoke.mjs",
    "test:runtime:bundled-seatbelt": "node scripts/bundled-seatbelt-smoke.mjs",
    "package:mac": "bash scripts/package-macos.sh local",
    "package:mac:release": "bash scripts/package-macos.sh release",
    "test:electron-packaged": "node scripts/packaged-electron-smoke.mjs",
    "test:packaging": "node --test scripts/packaging-config.test.mjs scripts/package-macos.test.mjs scripts/test-affected.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-arborist": "3.16.0",
    "react-diff-view": "3.3.3",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^42.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
