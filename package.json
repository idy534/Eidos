{
  "name": "eidos",
  "productName": "Eidos",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm build:preload && pnpm build:main && pnpm build:renderer",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && vite build",
    "start": "pnpm build && electron .",
    "python:sync": "uv sync --locked",
    "test": "pnpm test:runtime && pnpm test:contracts && pnpm test:renderer-state && pnpm test:main && pnpm test:renderer-behavior",
    "test:runtime": "uv run --locked pytest",
    "lint:python": "uv run --locked ruff check runtime/eidos_runtime runtime/tests scripts/test-seatbelt-native.py",
    "deps:python": "uv run --locked deptry runtime/eidos_runtime",
    "audit:python": "scripts/audit-python.sh",
    "check:python": "pnpm lint:python && pnpm deps:python && pnpm test:runtime && pnpm audit:python",
    "test:contracts": "node --test scripts/check-desktop-contracts.test.mjs && node scripts/check-desktop-contracts.mjs",
    "test:renderer-state": "node scripts/check-renderer-test-discovery.mjs && node --test \"dist/renderer-test/**/*.test.js\"",
    "test:renderer-behavior": "vitest run --config vitest.renderer.config.ts",
    "test:main": "pnpm build:main && node --test \"dist/main/*.test.js\"",
    "test:desktop": "pnpm build && pnpm test:contracts && pnpm test:renderer-state && pnpm test:renderer-behavior && pnpm test:main",
    "test:seatbelt-native": ".venv/bin/python scripts/test-seatbelt-native.py",
    "test:electron-smoke": "node scripts/electron-smoke.mjs",
    "build:runtime:mac": "bash scripts/build-macos-runtime.sh",
    "test:runtime:bundled": "node scripts/bundled-runtime-smoke.mjs",
    "test:runtime:bundled-seatbelt": "node scripts/bundled-seatbelt-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^42.4.1",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
